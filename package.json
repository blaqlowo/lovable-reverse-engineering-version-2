{
  "name": "app-builder",
  "version": "0.1.0",
  "private": true,
  "description": "An AI app builder: describe an app, watch it get built, export the code.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:server": "tsx --env-file=.env server/start.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx server/tests/parser.ts && tsx server/tests/api.ts && npm test --prefix client",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
