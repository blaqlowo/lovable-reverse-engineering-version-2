# Local development only. Copy to .env and fill in. NEVER commit .env to GitHub.
# On Vercel, set these in Project Settings > Environment Variables instead.
ANTHROPIC_API_KEY=

# Optional
MODEL=claude-sonnet-5-5
PORT=3000
DAILY_LIMIT=500
PER_IP_PER_MINUTE=6

# Bot check (Cloudflare Turnstile). Leave empty to turn it off while developing.
# The SITE key (public) goes in client/.env as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=
